NEXT_PUBLIC_SITE_URL=https://cosmicblueprint.com
# Required for AI Deep Reading feature (Phase 2).
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# Optional: model name override (defaults to deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat
# Required for payment processing (Phase 6).
# Sandbox: https://sandbox-login.paddle.com → Developer Tools → Authentication
# Client-side token for Paddle.js checkout
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=pdl_...
# Server-side API key (only used in API routes, never exposed to browser)
PADDLE_API_KEY=pdl_...
